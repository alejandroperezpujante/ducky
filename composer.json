{
  "name": "tempest/app",
  "type": "project",
  "require": {
    "tempest/framework": "^3.0",
    "hidehalo/nanoid-php": "^2.0"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "carthage-software/mago": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php ./vendor/bin/tempest install framework -f",
      "@php ./tempest discovery:generate --no-interaction",
      "@php ./tempest key:generate"
    ],
    "post-autoload-dump": [
      "@php ./vendor/bin/tempest discovery:generate --no-interaction"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "pnpx concurrently -c \"#93c5fd,#c4b5fd\" \"php tempest serve\" \"pnpm run dev\" --names=server,vite --kill-others"
    ],
    "pest": "vendor/bin/pest",
    "fmt": "vendor/bin/mago fmt",
    "lint": "vendor/bin/mago lint --fix --format-after-fix",
    "qa": [
      "composer fmt",
      "composer pest",
      "composer lint"
    ]
  },
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "carthage-software/mago": true,
      "pestphp/pest-plugin": true
    }
  }
}

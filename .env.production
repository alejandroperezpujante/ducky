# Production environment template.
# Copy to .env on the server and fill in the values.
# Generate the signing key with:
#   docker compose run --rm app php tempest key:generate

SIGNING_KEY=

ENVIRONMENT=production
BASE_URI=https://your-domain.tld

# Enable all caches in production
INTERNAL_CACHES=true
DISCOVERY_CACHE=true

# PHP executable path inside the container
PHP_EXECUTABLE_PATH=/usr/local/bin/php

# Logging (set paths or null to disable)
DEBUG_LOG_PATH=null
SERVER_LOG_PATH=null
